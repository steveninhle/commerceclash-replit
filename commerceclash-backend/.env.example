# Application settings
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
APP_PREFIX=NestJS-Auth

# Supabase connection
SUPABASE_URL=your_supabase_db_url
SUPABASE_ANON_KEY=your_supabase_db_anon_key
SUPABASE_SERVICE_KEY=your_supabase_db_secret_role_key

# Database connection for Prisma
DATABASE_URL=your_db_url

#Zoom Credentials
ZOOM_CLIENT_ID='your_zoom_client_id'
ZOOM_CLIENT_SECRET='your_zoom_client_secret'
ZOOM_ACCOUNT_ID='your_zoom_account_id'
ZOOM_OAUTH_ENDPOINT='https://zoom.us/oauth/token'
ZOOM_API_BASE_URL='https://api.zoom.us/v2'

# frontend url
FRONTEND_URL='your-frontend-url'

# Cohort scheduling
# IANA timezone (e.g. Asia/Ho_Chi_Minh) used ONLY as a fallback when a cohort
# has no saved timezone (e.g. cohorts created before timezone capture was
# added). Never used to reconvert an already-stored UTC start_time. Defaults
# to UTC if unset — set this explicitly for your primary user base so
# schedules for legacy cohorts don't silently generate at UTC-offset times.
DEFAULT_COHORT_TIMEZONE='Asia/Ho_Chi_Minh'

# Default meeting assigned by the meeting-link cron (MeetingCronService)
DEFAULT_MEETING_ID='your_default_meeting_id'
DEFAULT_MEETING_LINK='https://zoom.us/j/your_default_meeting'
DEFAULT_PASSCODE='your_default_passcode'

# Stripe
STRIPE_SECRET_KEY='sk_test_...'
STRIPE_WEBHOOK_SECRET='whsec_...'
STRIPE_PRICE_ID='price_...'

# Resend (transactional email)
RESEND_API_KEY='re_...'
RESEND_FROM_EMAIL='Commerce Clash <no-reply@your-domain.com>'

# Development-only perk test lab (enable explicitly for local testing)
ENABLE_PROTOTYPE_PERKS=false
